solid test_slope
  facet normal 0.0 0.0 1.0
    outer loop
      vertex 0.0 0.0 50.0
      vertex 0.0 50.0 50.0
      vertex 20.0 0.0 50.0
    endloop
  endfacet
  facet normal 0.0 0.0 1.0
    outer loop
      vertex 0.0 50.0 50.0
      vertex 20.0 50.0 50.0
      vertex 20.0 0.0 50.0
    endloop
  endfacet
  facet normal 0.55 0.0 0.83
    outer loop
      vertex 20.0 0.0 50.0
      vertex 20.0 50.0 50.0
      vertex 80.0 0.0 10.0
    endloop
  endfacet
  facet normal 0.55 0.0 0.83
    outer loop
      vertex 20.0 50.0 50.0
      vertex 80.0 50.0 10.0
      vertex 80.0 0.0 10.0
    endloop
  endfacet
  facet normal 0.0 0.0 1.0
    outer loop
      vertex 80.0 0.0 10.0
      vertex 80.0 50.0 10.0
      vertex 100.0 0.0 10.0
    endloop
  endfacet
  facet normal 0.0 0.0 1.0
    outer loop
      vertex 80.0 50.0 10.0
      vertex 100.0 50.0 10.0
      vertex 100.0 0.0 10.0
    endloop
  endfacet
endsolid test_slope
