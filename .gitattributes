# .gitattributes — SimRocas 2D
# Force text files regardless of OS and normalize line endings to LF.
# Prevents CRLF surprises when contributors edit from Windows or sync
# via OneDrive/Dropbox/iCloud, and keeps `git diff` focused on real content.

# Catch-all: treat unknown text extensions as text, normalize to LF
*               text=auto eol=lf

# Explicit text files (project + docs)
*.md            text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.txt           text eol=lf

# Binary assets — never touch
*.stl           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.pdf           binary
*.ico           binary
